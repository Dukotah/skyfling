{
  "name": "skyfling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ad-free 3D slingshot-plane game for iPhone (installable PWA).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "playwright test",
    "gen:icons": "node scripts/gen-icons.mjs",
    "assets": "node scripts/assets-fetch.mjs",
    "assets:force": "node scripts/assets-fetch.mjs --force"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.48.0",
    "@types/three": "^0.186.0",
    "detect-gpu": "^5.0.70",
    "eslint": "^9.12.0",
    "globals": "^17.13.0",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "sharp": "^0.33.5",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.2"
  }
}
